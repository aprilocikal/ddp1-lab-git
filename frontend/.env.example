# SCELE Credentials (dipakai backend untuk ambil token)
# JANGAN commit file .env ke git!
SCELE_BASE_URL=https://scele.cs.ui.ac.id

# VAPID Keys untuk Web Push
# Generate dengan: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:youremail@ui.ac.id

# Secret key untuk protect polling endpoint
CRON_SECRET=ganti-dengan-random-string-panjang

# Google Gemini AI (untuk fitur AI Chat)
# Dapatkan gratis di: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
